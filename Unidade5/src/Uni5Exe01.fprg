    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, numero" type="Integer" array="False" size=""/>
            <for variable="i" start="1" end="20" direction="inc" step="1">
                <input variable="numero"/>
                <if expression="numero % 2 = 0">
                    <then>
                        <output expression="&quot;Par&quot;" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;&#205;mpar&quot;" newline="True"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
