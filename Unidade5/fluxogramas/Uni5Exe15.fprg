<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Uni5Exe15"/>
        <attribute name="authors" value="mclopes"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-29 09:33:29 "/>
        <attribute name="created" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDktMjk7IjA5OjI2OjE2ICI7MjM1OQ=="/>
        <attribute name="edited" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDktMjk7IjA5OjMzOjI5ICI7MTsyNDY5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nome" type="String" array="False" size=""/>
            <declare name="nota1, nota2, media" type="Real" array="False" size=""/>
            <input variable="nome"/>
            <while expression="nome &lt;&gt; &quot;fim&quot;">
                <input variable="nota1"/>
                <input variable="nota2"/>
                <assign variable="media" expression="(nota1 + nota2) / 2"/>
                <output expression="media" newline="True"/>
                <input variable="nome"/>
            </while>
        </body>
    </function>
</flowgorithm>
