    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="soma" type="Real" array="False" size=""/>
            <assign variable="soma" expression="0"/>
            <for variable="i" start="1" end="100" direction="inc" step="1">
                <assign variable="soma" expression="soma + 1 / i"/>
            </for>
            <output expression="soma" newline="True"/>
        </body>
    </function>
