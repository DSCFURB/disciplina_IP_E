<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Uni2Exe14"/>
        <attribute name="authors" value="mclopes"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-11 09:57:11 "/>
        <attribute name="created" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDgtMTE7IjA5OjQ5OjI2ICI7MjM1NQ=="/>
        <attribute name="edited" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDgtMTE7IjA5OjU3OjExICI7MTsyNDU2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor, notas100, notas50, notas20, notas10, notas5, notas2, notas1" type="Integer" array="False" size=""/>
            <input variable="valor"/>
            <assign variable="notas100" expression="valor/100"/>
            <assign variable="notas50" expression="valor%100/50"/>
            <assign variable="notas20" expression="valor%100%50/20"/>
            <assign variable="notas10" expression="valor%100%50%20/10"/>
            <assign variable="notas5" expression="valor%100%50%20%10/5"/>
            <assign variable="notas2" expression="valor%100%50%20%10%5/2"/>
            <assign variable="notas1" expression="valor%100%50%20%10%5%2"/>
            <output expression="notas100" newline="True"/>
            <output expression="notas50" newline="True"/>
            <output expression="notas20" newline="True"/>
            <output expression="notas10" newline="True"/>
            <output expression="notas5" newline="True"/>
            <output expression="notas2" newline="True"/>
            <output expression="notas1" newline="True"/>
        </body>
    </function>
</flowgorithm>
