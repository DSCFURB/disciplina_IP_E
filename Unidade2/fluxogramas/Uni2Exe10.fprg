<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Uni2Exe10"/>
        <attribute name="authors" value="mclopes"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-11 09:37:47 "/>
        <attribute name="created" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDgtMTE7IjA5OjMxOjQ5ICI7MjM1MQ=="/>
        <attribute name="edited" value="bWNsb3BlcztOQi0wNTgxOzIwMjYtMDgtMTE7IjA5OjM3OjQ3ICI7MjsyNDY0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="duracao, horas, minutos, segundos" type="Integer" array="False" size=""/>
            <input variable="duracao"/>
            <assign variable="horas" expression="duracao / 3600"/>
            <assign variable="minutos" expression="duracao % 3600 / 60"/>
            <assign variable="segundos" expression="duracao % 3600 % 60"/>
            <output expression="horas" newline="True"/>
            <output expression="minutos" newline="True"/>
            <output expression="segundos" newline="True"/>
        </body>
    </function>
</flowgorithm>
